{
  "projects": [
    {
      "canonical_repo": "leonbreukelman/rtx3070-workshop-ops",
      "default_branch": "main",
      "enabled": true,
      "issue_tracker": {
        "labels_must_exist": true,
        "repo": "leonbreukelman/rtx3070-workshop-ops",
        "type": "github"
      },
      "label_mapping": {
        "base": [
          "smactorio",
          "autonomy:ready"
        ],
        "readiness": {
          "blocked": "smactorio:blocked",
          "draft": "autonomy:ready",
          "human_review": "needs-human"
        },
        "risk": {
          "high": "risk:high",
          "low": "risk:low",
          "medium": "risk:medium",
          "strategic": "risk:strategic"
        },
        "type": {
          "docs": "type:docs",
          "research": "type:research",
          "research_proposal": "type:research-proposal"
        }
      },
      "local_path": ".",
      "non_goals": [
        "Do not create branches or PRs from the processor.",
        "Do not modify service or timer units.",
        "Do not deploy, merge, rotate credentials, change billing, or perform destructive work."
      ],
      "north_star": "Turn validated Signal Hub evidence into safe GitHub issues SmactorIO can pick up.",
      "owner": "Leon",
      "project_id": "smactorio",
      "publication_policy": {
        "allow_label_creation": true,
        "allow_project_metadata_creation": false,
        "human_review_required_for": [
          "public_repo",
          "high_risk"
        ],
        "max_new_issues_per_run": 1,
        "max_open_generated_issues": 10,
        "mode": "publish_ready"
      },
      "redaction_policy": {
        "max_evidence_quote_chars": 600,
        "public_issue_body": "strict",
        "redact_local_paths": true,
        "redact_secret_like_values": true
      },
      "research_policy": {
        "allow_network": true,
        "allowed_hosts": [
          "openai.com",
          "github.com",
          "arxiv.org",
          "microsoft.com"
        ],
        "auto_issue_allowed": false,
        "caps": {
          "max_facets_per_run": 6,
          "max_model_driven_cards_per_run": 5,
          "max_options_per_card": 3,
          "max_questions_per_facet": 2,
          "max_search_queries_per_question": 3,
          "max_sources_per_card": 5,
          "max_sources_per_question": 5
        },
        "enabled": true,
        "execution_tiers": [
          "review_only"
        ],
        "fixtures": [],
        "max_bytes_per_source": 131072,
        "max_opportunities_per_run": 8,
        "max_sources_per_run": 4,
        "mode": "manual_review_only",
        "model_driven_planning": true,
        "network_timeout_seconds": 12,
        "publish_executable_issues": false,
        "publish_review_issues": false,
        "question_taxonomy_path": "signal-hub/config/research_question_taxonomy.json",
        "review_to_work_bridge": {
          "allowed_execution_modes": [
            "plan_only",
            "work_candidate"
          ],
          "enabled": true,
          "issue_ticket_bridge": {
            "allowed_ready_risks": [
              "low"
            ],
            "auto_publish": true,
            "enabled": true,
            "planner": "rsvl-mr",
            "required_approval_mode": "work_candidate"
          },
          "output": "smactorio_ready_issue",
          "requires_policy_event": true
        },
        "source_catalog_path": "signal-hub/config/research_source_catalog.json",
        "sources": [
          {
            "applicability_score": 3,
            "component": "ai-provider-strategy",
            "confidence_score": 3,
            "expected_value": 3,
            "implementation_hint": "Provider/tooling research lead only; require human review before provider, API, cost, or product behavior changes.",
            "max_items": 2,
            "novelty_score": 3,
            "opportunity_type": "model_provider_change",
            "risk_score": 3,
            "source_type": "lab_blog",
            "url": "https://openai.com/news/rss.xml",
            "verification": [
              "git diff --check"
            ]
          },
          {
            "applicability_score": 4,
            "component": "mcp-tooling",
            "confidence_score": 4,
            "expected_value": 4,
            "implementation_hint": "Review for MCP/Hermes integration relevance; no dependency or tool update without a plan.",
            "max_items": 2,
            "novelty_score": 3,
            "opportunity_type": "dependency_change",
            "risk_score": 3,
            "source_type": "open_source_project",
            "url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases.atom",
            "verification": [
              "git diff --check"
            ]
          },
          {
            "applicability_score": 2,
            "component": "agent-research",
            "confidence_score": 2,
            "expected_value": 2,
            "implementation_hint": "Research-note inspiration only; do not convert papers directly into work orders.",
            "max_items": 2,
            "novelty_score": 4,
            "opportunity_type": "project_direction",
            "risk_score": 3,
            "source_type": "paper",
            "url": "https://rss.arxiv.org/rss/cs.AI",
            "verification": [
              "git diff --check"
            ]
          },
          {
            "applicability_score": 2,
            "component": "agent-research",
            "confidence_score": 3,
            "expected_value": 2,
            "implementation_hint": "Reviewed research lead only; require local corroboration before project change.",
            "max_items": 2,
            "novelty_score": 3,
            "opportunity_type": "project_direction",
            "risk_score": 3,
            "source_type": "lab_blog",
            "url": "https://www.microsoft.com/en-us/research/feed/",
            "verification": [
              "git diff --check"
            ]
          }
        ]
      },
      "risk_policy": {
        "execution_stop_conditions": [
          "Requires credentials, 2FA, billing changes, or admin/security approval.",
          "Requires destructive operations or production mutations.",
          "Requires bypassing normal SmactorIO worker issue/PR flow."
        ],
        "publish_blockers": [
          "spend",
          "2fa",
          "destructive",
          "credential_access",
          "production_mutation"
        ]
      },
      "source_adapters": [
        {
          "max_bytes_per_file": 24000,
          "max_files": 80,
          "roots": [
            "README.md",
            "signal-hub/docs",
            "signal-hub/config",
            "signal-hub/data/project_homepages"
          ],
          "type": "repo_docs"
        },
        {
          "max_bytes_per_file": 24000,
          "max_files": 120,
          "roots": [
            "signal-hub/scripts",
            "signal-hub/tests",
            "signal-hub/config"
          ],
          "type": "repo_code"
        },
        {
          "limit": 100,
          "states": [
            "open",
            "closed"
          ],
          "type": "github_issues"
        }
      ],
      "status": "active",
      "title": "SmactorIO",
      "verification_defaults": [
        "signal-hub/scripts/run_tests.sh signal-hub/tests/ -v",
        "git diff --check",
        "python3 signal-hub/scripts/scan_for_secrets.py signal-hub/docs signal-hub/scripts signal-hub/tests"
      ],
      "visibility": "private"
    }
  ],
  "registry_version": "project-improvement-registry-v1",
  "runtime_role": "manual_research"
}
